# Conexión a Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:CONTRASEÑA@localhost:5432/SISTEMI_RESTAURANTE
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=SISTEMI_RESTAURANTE;Username=postgres;Password=CAMBIAR_CONTRASEÑA"

# Administrador Inicial del Sistema
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@restaurante.local
ADMIN_PASSWORD=CAMBIAR_CONTRASEÑA
ADMIN_FULLNAME="Administrador Principal"

# Parámetros de Seguridad y Bloqueo
SECURITY_MAX_FAILED_ACCESS_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15

