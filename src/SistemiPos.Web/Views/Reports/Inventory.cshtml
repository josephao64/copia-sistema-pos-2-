@model SistemiPos.Web.Models.Reports.InventoryReportViewModel
@{
    ViewData["Title"] = "Reporte de inventario";
}

<section class="page-header"><div><p class="eyebrow">Reportes</p><h1>Inventario</h1></div></section>
<div class="topbar-actions">
    <a asp-action="Sales" class="button-secondary link-button">Ventas</a>
    <a asp-action="Products" class="button-secondary link-button">Productos</a>
    <a asp-action="Purchases" class="button-secondary link-button">Compras</a>
    <a asp-action="Cash" class="button-secondary link-button">Caja</a>
</div>

<div class="grid">
    <article class="table-card"><h2>Existencias</h2><table class="data-table"><thead><tr><th>Código</th><th>Nombre</th><th>Categoría</th><th>Stock</th><th>Mínimo</th></tr></thead><tbody>@foreach (var item in Model.Report.Stocks){<tr><td>@item.InternalCode</td><td>@item.ProductName</td><td>@item.CategoryName</td><td>@DisplayFormats.Quantity(item.CurrentStock)</td><td>@DisplayFormats.Quantity(item.MinimumStock)</td></tr>}</tbody></table></article>
</div>
<div class="grid">
    <article class="table-card"><h2>Stock bajo</h2><table class="data-table"><thead><tr><th>Nombre</th><th>Stock</th></tr></thead><tbody>@foreach (var item in Model.Report.LowStock){<tr><td>@item.ProductName</td><td>@DisplayFormats.Quantity(item.CurrentStock)</td></tr>}</tbody></table></article>
    <article class="table-card"><h2>Agotados</h2><table class="data-table"><thead><tr><th>Nombre</th><th>Stock</th></tr></thead><tbody>@foreach (var item in Model.Report.OutOfStock){<tr><td>@item.ProductName</td><td>@DisplayFormats.Quantity(item.CurrentStock)</td></tr>}</tbody></table></article>
</div>
<div class="table-card">
    <h2>Kardex</h2>
    <table class="data-table"><thead><tr><th>Fecha</th><th>Nombre</th><th>Tipo</th><th>Cantidad</th><th>Anterior</th><th>Nueva</th><th>Documento</th></tr></thead><tbody>@foreach (var item in Model.Report.Kardex){<tr><td>@item.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@item.ProductName</td><td>@item.Type</td><td>@DisplayFormats.Quantity(item.Quantity)</td><td>@DisplayFormats.Quantity(item.PreviousStock)</td><td>@DisplayFormats.Quantity(item.NewStock)</td><td>@item.SourceDocument</td></tr>}</tbody></table>
</div>
