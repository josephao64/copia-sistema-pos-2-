@model SistemiPos.Web.Models.Security.UserResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<section class="page-header">
    <div>
        <span class="badge" style="background: #fee2e2; color: #991b1b; padding: 0.2rem 0.5rem; border-radius: 0.25rem;">Seguridad</span>
        <h1>Restablecer contraseña de usuario</h1>
        <p class="lead">Establece una nueva clave de acceso para <strong>@Model.FullName</strong> (@Model.UserName).</p>
    </div>
</section>

<div class="form-card" style="max-width: 500px;">
    <form asp-action="ResetPassword" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="UserName" type="hidden" />
        <input asp-for="FullName" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="field">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="input" autocomplete="new-password" placeholder="Mínimo 8 caracteres" autofocus />
            <span asp-validation-for="NewPassword" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmNewPassword"></label>
            <input asp-for="ConfirmNewPassword" class="input" autocomplete="new-password" placeholder="Repite la nueva contraseña" />
            <span asp-validation-for="ConfirmNewPassword" class="validation"></span>
        </div>

        <div class="action-row" style="display: flex; gap: 1rem; margin-top: 1rem;">
            <button type="submit" class="button-primary">Guardar nueva contraseña</button>
            <a asp-action="Index" class="button-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

