@model IReadOnlyList<SistemiPos.Application.Finance.PayableAccountDto>
@using Microsoft.AspNetCore.Mvc.Rendering
@using SistemiPos.Domain.Finance
@{
    ViewData["Title"] = "Cuentas por pagar";
    var supplierOptions = ViewBag.Suppliers as IReadOnlyList<SelectListItem> ?? Array.Empty<SelectListItem>();
}

<div class="table-card"><form method="get" class="form-grid compact-form-grid" data-auto-filter-form><div class="field"><label>Proveedor</label><select name="supplierId" class="input"><option value="">Todos</option>@foreach(var supplier in supplierOptions){<option value="@supplier.Value" selected="@(ViewBag.SupplierId?.ToString()==supplier.Value)">@supplier.Text</option>}</select></div><div class="field"><label>Estado</label><select name="status" class="input"><option value="">Todos</option>@foreach(var value in Enum.GetValues<AccountStatus>()){<option value="@value" selected="@(ViewBag.Status?.ToString()==value.ToString())">@value</option>}</select></div><div class="field"><label>Vence desde</label><input name="dueFrom" type="date" value="@(((DateTime?)ViewBag.DueFrom)?.ToString("yyyy-MM-dd"))" class="input"/></div><div class="field"><label>Vence hasta</label><input name="dueTo" type="date" value="@(((DateTime?)ViewBag.DueTo)?.ToString("yyyy-MM-dd"))" class="input"/></div><div class="action-row"><a asp-action="Index" class="button-ghost link-button">Limpiar</a></div></form></div>

@if (TempData["Error"] is string error)
{
    <div class="alert-error">@error</div>
}
@if (TempData["Success"] is string success)
{
    <div class="alert-success">@success</div>
}

@foreach (var account in Model)
{
    <article class="table-card finance-account-card">
        <div class="page-header finance-account-header">
            <div>
                <h2>@account.InvoiceNumber · @account.SupplierName</h2>
                <p class="helper-text">Vence @account.DueDateUtc.ToLocalTime().ToString("dd/MM/yyyy") · @account.Status</p>
            </div>
            <strong>Saldo @account.Balance.ToString("N2")</strong>
        </div>
        <div class="action-row"><a asp-action="Details" asp-route-id="@account.Id" class="button-secondary link-button">Ver detalle y pagos</a></div>

        @if (account.Balance > 0 && account.Status != AccountStatus.Cancelled)
        {
            <form asp-action="Pay" method="post" class="form-grid finance-payment-form" data-confirm="Se registrará el pago y se afectará el origen de dinero seleccionado. ¿Desea continuar?" data-confirm-title="Registrar pago" data-confirm-text="Sí, registrar pago">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@account.Id" />
                <div class="field"><label>Monto</label><input name="amount" type="number" min="0.01" max="@account.Balance" step="0.01" class="input" /></div>
                <div class="field"><label>Forma de pago</label><select name="paymentMethod" class="input"><option value="@FinancialPaymentMethod.Cash">Efectivo</option><option value="@FinancialPaymentMethod.Check">Cheque</option><option value="@FinancialPaymentMethod.Transfer">Transferencia</option><option value="@FinancialPaymentMethod.CardPos">Tarjeta/POS</option><option value="@FinancialPaymentMethod.Other">Otro</option></select></div>
                <div class="field"><label>Origen</label><select name="moneySource" class="input"><option value="@MoneySourceType.PettyCash">Caja chica</option><option value="@MoneySourceType.SalesCash">Caja de ventas</option><option value="@MoneySourceType.BankAccount">Cuenta bancaria</option><option value="@MoneySourceType.Other">Otro</option></select></div>
                <div class="field"><label>Referencia</label><input name="reference" class="input" /></div>
                <div class="field"><label>Usuario autorizador</label><input name="authorizerUserName" class="input" /></div>
                <div class="field"><label>Contraseña autorizador</label><input name="authorizerPassword" type="password" class="input" /></div>
                <div class="action-row full-span"><button class="button-primary">Registrar pago</button></div>
            </form>
            <form asp-action="Cancel" method="post" class="finance-account-footer" data-confirm="La cuenta por pagar quedará anulada. ¿Desea continuar?" data-confirm-title="Anular cuenta" data-confirm-text="Sí, anular cuenta">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@account.Id" />
                <button class="button-secondary">Anular cuenta sin pagos</button>
            </form>
        }
    </article>
}
