@model SistemiPos.Application.Finance.PayableAccountDetailDto
@using SistemiPos.Domain.Finance
@{ ViewData["Title"]="Detalle de cuenta por pagar"; }
@if(TempData["Error"] is string error){<div class="alert-error">@error</div>}@if(TempData["Success"] is string success){<div class="alert-success">@success</div>}
<div class="stats-grid"><article class="stat-card"><span>Factura</span><strong>@Model.InvoiceNumber</strong></article><article class="stat-card"><span>Compra</span><strong><a asp-controller="Purchases" asp-action="Details" asp-route-id="@Model.PurchaseId">@Model.PurchaseNumber</a></strong></article><article class="stat-card"><span>Pedido</span><strong>@if(Model.PurchaseOrderId.HasValue){<a asp-controller="Purchases" asp-action="OrderDetails" asp-route-id="@Model.PurchaseOrderId">@Model.PurchaseOrderNumber</a>}else{<text>—</text>}</strong></article><article class="stat-card"><span>Vencimiento</span><strong>@Model.DueDateUtc.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy")</strong></article><article class="stat-card"><span>Estado</span><strong>@Model.Status</strong></article><article class="stat-card"><span>Total</span><strong>Q @Model.Total.ToString("N2")</strong></article><article class="stat-card"><span>Pagado</span><strong>Q @Model.Paid.ToString("N2")</strong></article><article class="stat-card"><span>Saldo</span><strong>Q @Model.Balance.ToString("N2")</strong></article></div>
@if(Model.Balance>0&&Model.Status!=AccountStatus.Cancelled){<div class="form-card"><h2>Registrar pago</h2><form asp-action="Pay" method="post" class="form-grid two-columns">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><div class="field"><label>Monto</label><input name="amount" type="number" min="0.01" max="@Model.Balance" step="0.01" class="input" required/></div><div class="field"><label>Forma de pago</label><select name="paymentMethod" class="input"><option value="1">Efectivo</option><option value="2">Cheque</option><option value="3">Transferencia</option><option value="4">Tarjeta/POS</option><option value="5">Otro</option></select></div><div class="field"><label>Origen</label><select name="moneySource" class="input"><option value="2">Caja chica</option><option value="1">Caja de ventas</option><option value="3">Cuenta bancaria</option><option value="4">Otro</option></select></div><div class="field"><label>Referencia</label><input name="reference" class="input"/></div><div class="field"><label>Usuario autorizador</label><input name="authorizerUserName" class="input"/></div><div class="field"><label>Contraseña autorizador</label><input name="authorizerPassword" type="password" class="input"/></div><div class="action-row"><button class="button-primary">Registrar pago</button></div></form></div>}
<div class="table-card"><div class="table-toolbar"><h2>Historial de pagos</h2></div><table class="data-table payable-payments-table"><thead><tr><th>Fecha</th><th>Monto</th><th>Forma</th><th>Origen</th><th>Referencia</th><th>Usuario</th></tr></thead><tbody>@foreach(var payment in Model.Payments){<tr><td>@payment.PaidAtUtc.ToOffset(TimeSpan.FromHours(-6)).ToString("dd/MM/yyyy HH:mm")</td><td>Q @payment.Amount.ToString("N2")</td><td>@payment.PaymentMethod</td><td>@payment.MoneySource</td><td>@payment.Reference</td><td>@payment.UserName</td></tr>}@if(Model.Payments.Count==0){<tr><td colspan="6">Aún no hay pagos registrados.</td></tr>}</tbody></table></div>
