@model IReadOnlyList<SistemiPos.Application.Customers.CustomerHistoryDto>
@{
    ViewData["Title"] = "Historial de compras";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Clientes</p>
        <h1>Historial de compras</h1>
        <p class="lead">@ViewData["CustomerName"]</p>
    </div>
</section>

<div class="table-card">
    @if (Model.Count == 0)
    {
        <p class="helper-text">No hay historial de compras registrado para este cliente.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Documento</th>
                    <th>Fecha</th>
                    <th>Descripción</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.DocumentNumber</td>
                    <td>@item.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Description</td>
                    <td>Q @item.Total.ToString("N2")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
