@model IReadOnlyList<SistemiPos.Web.Models.Finance.PettyCashHistoryRow>
@{ ViewData["Title"] = "Historial"; }
<div class="table-card petty-cash-history-card">
    <div class="table-responsive"><table class="data-table petty-cash-history-table">
        <thead><tr><th>Caja chica</th><th>Responsable</th><th>Apertura</th><th>Cierre</th><th>Fondo</th><th>Saldo esperado</th><th>Contado</th><th>Diferencia</th><th class="action-column">Acción</th></tr></thead>
        <tbody>
        @foreach (var cycle in Model)
        {
            <tr><td>@cycle.FundName</td><td>@cycle.ResponsibleUserName</td><td>@cycle.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@cycle.ClosedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@cycle.InitialBalance.ToString("N2")</td><td>@cycle.ExpectedBalance?.ToString("N2")</td><td>@cycle.CountedBalance?.ToString("N2")</td><td>@cycle.Difference?.ToString("N2")</td><td class="action-column"><a asp-action="HistoryDetails" asp-route-id="@cycle.Id">Ver detalle</a></td></tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="9">Aún no hay ciclos de Caja chica cerrados.</td></tr> }
        </tbody>
    </table></div>
</div>
