@model SistemiPos.Web.Models.Finance.PettyCashCycleHistoryViewModel
@using SistemiPos.Domain.Finance
@{ ViewData["Title"] = "Detalle de Caja chica"; var cycle = Model.Cycle; }
<div class="form-card petty-cash-cycle-detail"><dl class="two-column-detail-list petty-cash-cycle-summary"><div><dt>Caja chica</dt><dd>@cycle.FundName</dd></div><div><dt>Responsable</dt><dd>@cycle.ResponsibleUserName</dd></div><div><dt>Apertura</dt><dd>@cycle.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Cierre</dt><dd>@cycle.ClosedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Fondo</dt><dd>@cycle.InitialBalance.ToString("N2")</dd></div><div><dt>Saldo esperado</dt><dd>@cycle.ExpectedBalance?.ToString("N2")</dd></div><div><dt>Contado</dt><dd>@cycle.CountedBalance?.ToString("N2")</dd></div><div><dt>Diferencia</dt><dd>@cycle.Difference?.ToString("N2")</dd></div></dl></div>
<div class="table-card petty-cash-history-card"><div class="table-responsive"><table class="data-table petty-cash-history-table"><thead><tr><th>Fecha</th><th>Tipo</th><th>Concepto</th><th>Documento</th><th>Proveedor / beneficiario</th><th>Monto</th><th>Estado</th></tr></thead><tbody>@foreach (var movement in Model.Movements) { <tr><td>@movement.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@movement.Type</td><td>@movement.Concept</td><td>@(movement.Document ?? "—")</td><td>@(movement.Beneficiary ?? "—")</td><td>@movement.Amount.ToString("N2")</td><td>@(movement.IsCancelled ? "Anulado" : "Vigente")</td></tr> } @if (Model.Movements.Count == 0) { <tr><td colspan="7">No hay movimientos registrados en este ciclo.</td></tr> }</tbody></table></div></div>
