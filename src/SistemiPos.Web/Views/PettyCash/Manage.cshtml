@model IReadOnlyList<SistemiPos.Domain.Finance.PettyCashFund>
@using SistemiPos.Infrastructure.Security
@{ ViewData["Title"] = "Administrar Cajas chicas"; var users = ViewBag.Users as IReadOnlyList<AppUser> ?? []; }
<section class="page-header"><div><p class="eyebrow">Configuración</p><h1>Cajas chicas</h1><p class="lead">Asigne una única Caja chica por usuario responsable.</p></div><button type="button" class="button-primary" data-fund-create data-quick-create-open="petty-cash-fund-modal">+ Nueva Caja chica</button></section>
@if (TempData["Error"] is string error) { <div class="alert-error">@error</div> } @if (TempData["Success"] is string success) { <div class="alert-success">@success</div> }
<div class="table-card"><table class="data-table"><thead><tr><th>Nombre</th><th>Responsable</th><th>Estado</th><th>Apertura</th><th>Cierre</th><th></th></tr></thead><tbody>@foreach(var fund in Model){<tr><td>@fund.Name</td><td>@fund.ResponsibleUserName</td><td>@(fund.IsActive ? "Activa" : "Inactiva")</td><td>@(fund.OpenedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td><td>@(fund.ClosedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td><td><button type="button" class="button-secondary" data-fund-edit data-id="@fund.Id" data-name="@fund.Name" data-user-id="@fund.ResponsibleUserId" data-active="@fund.IsActive.ToString().ToLowerInvariant()" data-quick-create-open="petty-cash-fund-modal">Editar</button></td></tr>}</tbody></table></div>
<dialog id="petty-cash-fund-modal" class="quick-create-modal" data-quick-create data-endpoint="@Url.Action("SaveFund")">
    <form method="dialog" class="quick-create-panel" data-quick-create-form>@Html.AntiForgeryToken()<input type="hidden" name="id" />
        <div class="modal-header"><h2 data-fund-modal-title>Nueva Caja chica</h2><button type="button" class="icon-button" aria-label="Cerrar" data-quick-create-cancel>×</button></div>
        <div class="form-grid compact-form-grid"><div class="field"><label>Nombre</label><input name="name" class="input" required /></div><div class="field"><label>Responsable</label><select name="responsibleUserId" class="input" required><option value="">Seleccione</option>@foreach(var user in users){<option value="@user.Id">@(string.IsNullOrWhiteSpace(user.FullName) ? user.UserName : $"{user.FullName} ({user.UserName})")</option>}</select></div><label class="checkbox"><input type="checkbox" name="isActive" value="true" checked /><span>Activa</span></label></div>
        <p class="validation" data-quick-create-error></p><div class="action-row"><button type="button" class="button-secondary" data-quick-create-cancel>Cancelar</button><button type="submit" class="button-primary">Guardar</button></div>
    </form>
</dialog>
@section Scripts { <script>(()=>{const dialog=document.querySelector('#petty-cash-fund-modal');const form=dialog.querySelector('form');document.querySelector('[data-fund-create]')?.addEventListener('click',()=>{form.reset();form.elements.id.value='';form.elements.isActive.checked=true;dialog.querySelector('[data-fund-modal-title]').textContent='Nueva Caja chica';});document.querySelectorAll('[data-fund-edit]').forEach(button=>button.addEventListener('click',()=>{form.elements.id.value=button.dataset.id;form.elements.name.value=button.dataset.name;form.elements.responsibleUserId.value=button.dataset.userId;form.elements.isActive.checked=button.dataset.active==='true';dialog.querySelector('[data-fund-modal-title]').textContent='Editar Caja chica';}));dialog.addEventListener('quickcreate:created',()=>location.reload());})();</script> }
