@model SistemiPos.Web.Models.Settings.DiscountSettingsViewModel
@{
    ViewData["Title"] = "Descuentos";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Configuración</p>
        <h1>Límites de descuento</h1>
    </div>
</section>

<div class="grid">
    <article class="form-card">
        <h2>Por rol</h2>
        <form asp-action="SaveRoleDiscount" method="post" class="form-grid">
            @Html.AntiForgeryToken()
            <div class="field"><label>Rol</label><select asp-for="SelectedRoleId" asp-items="Model.Roles" class="input"></select></div>
            <div class="field"><label>Máximo %</label><input asp-for="RoleMaxDiscountPercent" class="input" type="number" step="0.01" min="0" /></div>
            <div class="action-row"><button type="submit" class="button-primary">Guardar rol</button></div>
        </form>

        <table class="data-table">
            <thead><tr><th>Rol</th><th>Máximo %</th></tr></thead>
            <tbody>
            @foreach (var item in Model.RoleSettings)
            {
                <tr><td>@item.Name</td><td>@item.MaxDiscountPercent.ToString("N2")</td></tr>
            }
            </tbody>
        </table>
    </article>

    <article class="form-card">
        <h2>Por usuario</h2>
        <form asp-action="SaveUserDiscount" method="post" class="form-grid">
            @Html.AntiForgeryToken()
            <div class="field"><label>Usuario</label><select asp-for="SelectedUserId" asp-items="Model.Users" class="input"></select></div>
            <div class="field"><label>Máximo %</label><input asp-for="UserMaxDiscountPercent" class="input" type="number" step="0.01" min="0" /></div>
            <div class="action-row"><button type="submit" class="button-primary">Guardar usuario</button></div>
        </form>

        <table class="data-table">
            <thead><tr><th>Usuario</th><th>Máximo %</th></tr></thead>
            <tbody>
            @foreach (var item in Model.UserSettings)
            {
                <tr><td>@item.Name</td><td>@item.MaxDiscountPercent.ToString("N2")</td></tr>
            }
            </tbody>
        </table>
    </article>
</div>
