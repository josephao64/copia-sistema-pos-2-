@model SistemiPos.Web.Models.Settings.CashConfigurationViewModel
@using SistemiPos.Domain.Configuration
@{ ViewData["Title"] = "Moneda y denominaciones"; }
<section class="page-header"><div><p class="eyebrow">Configuración</p><h1>Denominaciones, POS y formas de pago</h1><p class="lead">Catálogos globales usados por ventas y arqueos. La moneda y su símbolo se editan en Configuración operativa.</p></div></section>
@if (TempData["Success"] is string ok) { <div class="alert-success">@ok</div> }
@if (TempData["Error"] is string error) { <div class="alert-error">@error</div> }
<div class="cash-configuration-grid">
<div class="table-card cash-config-denominations"><div class="table-toolbar"><h2>Denominaciones</h2><button type="button" class="button-primary" data-quick-create-open="denomination-modal">+ Agregar denominación</button></div>
<table class="data-table"><thead><tr><th>Tipo</th><th>Valor</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model.Denominations){<tr><td>@(x.Kind == DenominationKind.Banknote ? "Billete" : "Moneda")</td><td>@x.Value.ToString("N2")</td><td>@(x.IsActive ? "Activa" : "Inactiva")</td><td><form asp-action="ToggleDenomination" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="button-secondary">@(x.IsActive ? "Desactivar" : "Activar")</button></form></td></tr>}</tbody></table></div>
<div class="table-card cash-config-pos"><div class="table-toolbar"><h2>Dispositivos POS bancarios</h2><button type="button" class="button-primary" data-quick-create-open="pos-device-modal">+ Agregar POS</button></div>
<div class="table-responsive"><table class="data-table pos-device-table"><thead><tr><th>Nombre</th><th>Banco / proveedor</th><th>Terminal ID</th><th>Cuenta asociada</th><th>Ubicación / caja</th><th>Total vendido</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var x in Model.PosDevices){var account=Model.BankAccounts.FirstOrDefault(a=>a.Id==x.BankAccountId);<tr><td><strong>@x.Name</strong>@if(!string.IsNullOrWhiteSpace(x.Observation)){<small class="table-secondary-copy">@x.Observation</small>}</td><td>@(x.Provider??"—")</td><td>@(x.TerminalId??"—")</td><td>@(account is null?"—":$"{account.Bank} · {account.AccountName}")</td><td>@(x.Location??"—")</td><td>@Model.CurrencySymbol @Model.PosDeviceTotals.GetValueOrDefault(x.Id).ToString("N2")</td><td>@(x.IsActive ? "Activo" : "Inactivo")</td><td><div class="table-actions"><a asp-action="EditPosDevice" asp-route-id="@x.Id" class="button-secondary link-button" data-crud-modal>Editar</a><form asp-action="TogglePosDevice" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="button-secondary">@(x.IsActive ? "Desactivar" : "Activar")</button></form></div></td></tr>}</tbody></table></div></div>
<div class="table-card cash-config-payments"><h2>Formas de pago</h2><table class="data-table"><thead><tr><th>Nombre</th><th>Comportamiento</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var x in Model.PaymentMethods){var isCash=x.Behavior==PaymentFinancialBehavior.Cash;<tr><td>@x.Name</td><td>@x.Behavior</td><td>@(isCash || x.IsActive ? "Activa" : "Inactiva")</td><td>@if(isCash){<span class="table-secondary-copy">Siempre habilitada</span>}else{<form asp-action="TogglePaymentMethod" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="button-secondary">@(x.IsActive ? "Desactivar" : "Activar")</button></form>}</td></tr>}</tbody></table></div>
</div>

<dialog id="denomination-modal" class="quick-create-modal" data-quick-create data-endpoint="@Url.Action("AddDenomination")">
    <form method="dialog" class="quick-create-panel" data-quick-create-form>@Html.AntiForgeryToken()
        <div class="modal-header"><h2>Agregar denominación</h2><button type="button" class="icon-button" aria-label="Cerrar" data-quick-create-cancel>×</button></div>
        <div class="form-grid two-column-grid"><div class="field"><label>Tipo</label><select name="kind" class="input"><option value="@DenominationKind.Banknote">Billete</option><option value="@DenominationKind.Coin">Moneda</option></select></div><div class="field"><label>Valor</label><input name="value" type="number" min="0.01" step="0.01" class="input" required /></div></div>
        <p class="validation" data-quick-create-error></p><div class="action-row"><button type="button" class="button-secondary" data-quick-create-cancel>Cancelar</button><button type="submit" class="button-primary">Guardar</button></div>
    </form>
</dialog>
<dialog id="pos-device-modal" class="quick-create-modal" data-quick-create data-endpoint="@Url.Action("AddPosDevice")">
    <form method="dialog" class="quick-create-panel" data-quick-create-form>@Html.AntiForgeryToken()
        <div class="modal-header"><h2>Agregar dispositivo POS</h2><button type="button" class="icon-button" aria-label="Cerrar" data-quick-create-cancel>×</button></div>
        <div class="form-grid two-column-grid">
            <div class="field"><label>Nombre</label><input name="Name" class="input" maxlength="100" placeholder="Ej. BAC #1" required /></div>
            <div class="field"><label>Banco / proveedor</label><input name="Provider" class="input" maxlength="100" placeholder="Ej. BAC" required /></div>
            <div class="field"><label>Terminal ID</label><input name="TerminalId" class="input" maxlength="100" autocomplete="off" required /></div>
            <div class="field"><label>Cuenta bancaria asociada</label><select name="BankAccountId" class="input" required><option value="">Seleccionar cuenta</option>@foreach(var account in Model.BankAccounts){<option value="@account.Id">@account.Bank · @account.AccountName · @account.AccountNumber</option>}</select></div>
            <div class="field full-span"><label>Ubicación / caja</label><input name="Location" class="input" maxlength="150" placeholder="Ej. Caja principal" required /></div>
            <div class="field full-span"><label>Observación <small>(opcional)</small></label><textarea name="Observation" class="input textarea" maxlength="500" rows="2"></textarea></div>
            <label class="checkbox full-span"><input name="IsActive" type="checkbox" value="true" checked /><input name="IsActive" type="hidden" value="false" /><span>Activo</span></label>
        </div>
        <p class="validation" data-quick-create-error></p><div class="action-row"><button type="button" class="button-secondary" data-quick-create-cancel>Cancelar</button><button type="submit" class="button-primary">Guardar</button></div>
    </form>
</dialog>
@section Scripts { <script>document.querySelectorAll('#denomination-modal,#pos-device-modal').forEach(x => x.addEventListener('quickcreate:created', () => location.reload()));</script> }
