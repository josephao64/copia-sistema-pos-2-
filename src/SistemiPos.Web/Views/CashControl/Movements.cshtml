@model IReadOnlyList<SistemiPos.Domain.Cash.CashMovement>
@using SistemiPos.Domain.Cash
@{ViewData["Title"]="Movimientos de caja";}
@if(TempData["Error"] is string e){<div class="alert-error">@e</div>}@if(TempData["Success"] is string s){<div class="alert-success">@s</div>}
@if(ViewBag.CurrentSession is SistemiPos.Application.Cash.CashSessionDto current){<div class="table-card cash-module-table"><form asp-action="AddMovement" method="post" class="form-grid two-column-grid">@Html.AntiForgeryToken()<input type="hidden" name="cashSessionId" value="@current.Id"/><div class="field"><label>Tipo</label><select name="type" class="input"><option value="@CashMovementType.OtherIncome">Entrada</option><option value="@CashMovementType.Expense">Salida</option><option value="@CashMovementType.CashWithdrawal">Retiro</option><option value="@CashMovementType.CashTransfer">Traslado</option></select></div><div class="field"><label>Monto</label><input name="amount" type="number" min="0.01" step="0.01" class="input"/></div><div class="field full-span"><label>Concepto / motivo</label><input name="reason" class="input"/></div><div class="field"><label>Usuario autorizador</label><input name="authorizerUserName" class="input"/></div><div class="field"><label>Contraseña autorizador</label><input name="authorizerPassword" type="password" class="input"/></div><div class="action-row full-span"><button class="button-primary">Registrar movimiento</button></div></form></div>}
<div class="table-card cash-module-table"><div class="table-responsive"><table class="data-table"><thead><tr><th>Fecha</th><th>Sesión</th><th>Tipo</th><th>Monto</th><th>Concepto</th><th>Usuario</th><th>Autorizó</th><th>Documento</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@x.CashSessionId</td><td>@x.Type</td><td>@x.Amount.ToString("N2")</td><td>@x.Reason</td><td>@x.UserName</td><td>@(x.AuthorizedByUserName??"—")</td><td>@(x.SourceDocument??"—")</td></tr>}</tbody></table></div></div>
