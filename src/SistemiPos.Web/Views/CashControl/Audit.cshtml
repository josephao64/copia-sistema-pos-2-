@model IReadOnlyList<SistemiPos.Domain.Audit.FinancialAuditEntry>
@{ViewData["Title"]="Auditoría de caja";}
<div class="table-card cash-module-table"><div class="table-responsive"><table class="data-table cash-audit-table"><thead><tr><th>Fecha y hora</th><th>Usuario</th><th>Evento / movimiento</th><th>Origen</th><th>Referencia</th><th>Monto</th><th>Detalle</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td><td>@x.UserName</td><td>@x.Action</td><td>@(x.DocumentType ?? "Caja de venta")</td><td>@(x.DocumentReference??"—")</td><td>@(x.Amount?.ToString("N2")??"—")</td><td>@(x.AuthorizedByUserName is null ? x.Comment ?? "—" : $"{x.Comment ?? ""} · Autorizó: {x.AuthorizedByUserName}")</td></tr>}</tbody></table></div></div>
