@model SistemiPos.Application.Finance.ReceivableAccountDetailDto
@using SistemiPos.Domain.Finance
@{ ViewData["Title"] = "Detalle de cuenta"; var symbol = ViewBag.CurrencySymbol as string ?? "Q"; var decimals = ViewBag.CurrencyDecimals is int value ? value : 2; string Money(decimal amount) => $"{symbol} {amount.ToString($"N{decimals}")}"; string StatusLabel(AccountStatus status) => status switch { AccountStatus.Pending => "Pendiente", AccountStatus.PartiallyPaid => "Parcialmente abonada", AccountStatus.Paid => "Pagada", AccountStatus.Overdue => "En período de gracia", AccountStatus.Delinquent => "En mora", AccountStatus.Cancelled => "Anulada", _ => status.ToString() }; }
<div class="form-card receivable-detail"><dl class="two-column-detail-list receivable-detail-summary"><div><dt>Cliente / Empresa</dt><dd>@Model.CustomerName</dd></div><div><dt>NIT</dt><dd>@(Model.CustomerNit ?? "—")</dd></div><div><dt>Venta relacionada</dt><dd><a asp-controller="Sales" asp-action="Details" asp-route-id="@Model.SaleId">@Model.SaleNumber</a></dd></div><div><dt>Fecha de venta</dt><dd>@Model.SaleDateUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Total</dt><dd>@Money(Model.Total)</dd></div><div><dt>Abonado</dt><dd>@Money(Model.Paid)</dd></div><div><dt>Saldo</dt><dd><strong>@Money(Model.Balance)</strong></dd></div><div><dt>Vencimiento</dt><dd>@Model.DueDateUtc.ToLocalTime().ToString("dd/MM/yyyy")</dd></div><div><dt>Días de crédito</dt><dd>@Model.CreditDays</dd></div><div><dt>Días de gracia</dt><dd>@Model.GraceDays</dd></div><div><dt>Estado</dt><dd>@StatusLabel(Model.Status)</dd></div></dl>@if (Model.Balance > 0 && Model.Paid == 0){<form asp-action="Cancel" method="post" class="receivable-detail-actions" data-confirm="La cuenta por cobrar quedará anulada. ¿Desea continuar?" data-confirm-title="Anular cuenta" data-confirm-text="Sí, anular cuenta">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path"/><button type="submit" class="button-secondary">Anular cuenta sin abonos</button></form>}</div>
<div class="table-card receivable-payments-card"><div class="table-toolbar"><div><h2>Abonos y pagos</h2></div></div><table class="data-table receivable-payments-table"><thead><tr><th>Fecha del movimiento</th><th>Monto</th><th>Forma de pago</th><th>Referencia</th><th>Usuario</th></tr></thead><tbody>@foreach(var payment in Model.Payments){<tr><td>@payment.ReceivedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@Money(payment.Amount)</td><td>@(payment.PaymentMethod == FinancialPaymentMethod.Cash ? "Efectivo" : payment.PaymentMethod == FinancialPaymentMethod.Transfer ? "Transferencia" : payment.PaymentMethod.ToString())</td><td>@(payment.Reference ?? "—")</td><td>@payment.UserName</td></tr>}@if(Model.Payments.Count == 0){<tr><td colspan="5">Aún no hay abonos registrados.</td></tr>}</tbody></table></div>
