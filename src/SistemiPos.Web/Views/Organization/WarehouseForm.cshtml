@model SistemiPos.Web.Models.Organizations.WarehouseFormViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar bodega" : "Nueva bodega";
}

<div class="modal-form-content">
    <h2>@ViewData["Title"]</h2>
    <form asp-action="@(Model.Id.HasValue ? "EditWarehouse" : "CreateWarehouse")" method="post" class="form-grid">
        @Html.AntiForgeryToken()
        @if (Model.Id.HasValue)
        {
            <input asp-for="Id" type="hidden" />
        }

        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="field" style="grid-column: 1 / -1;">
            <label asp-for="BranchId"></label>
            <select asp-for="BranchId" asp-items="Model.AvailableBranches" class="input" required></select>
            <span asp-validation-for="BranchId" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="input" placeholder="Ej. BOD-01" required />
            <span asp-validation-for="Code" class="validation"></span>
        </div>

        <div class="field">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="input" placeholder="Ej. Bodega Principal" required />
            <span asp-validation-for="Name" class="validation"></span>
        </div>

        <div class="field" style="grid-column: 1 / -1;">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="input" rows="2" placeholder="Ubicación o notas de la bodega"></textarea>
            <span asp-validation-for="Description" class="validation"></span>
        </div>

        <label class="checkbox">
            <input asp-for="IsDefault" />
            <span>Bodega principal predeterminada</span>
        </label>

        <label class="checkbox">
            <input asp-for="IsKitchen" />
            <span>Punto de cocina / preparación</span>
        </label>

        @if (Model.Id.HasValue)
        {
            <label class="checkbox">
                <input asp-for="IsActive" />
                <span>Activo</span>
            </label>
        }

        <div class="action-row" style="grid-column: 1 / -1;">
            <button type="submit" class="button-primary">Guardar</button>
        </div>
    </form>
</div>
