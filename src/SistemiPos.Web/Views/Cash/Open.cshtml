@model SistemiPos.Web.Models.Cash.OpenCashSessionViewModel
@using SistemiPos.Domain.Configuration
@{
    ViewData["Title"] = "Abrir caja";
    var symbol = ViewBag.CurrencySymbol as string ?? "Q";
    var denominations = ViewBag.Denominations as IReadOnlyList<CashDenomination> ?? [];
    var banknotes = denominations.Where(x => x.Kind == DenominationKind.Banknote).OrderByDescending(x => x.Value).ToList();
    var coins = denominations.Where(x => x.Kind == DenominationKind.Coin).OrderByDescending(x => x.Value).ToList();
    var enteredQuantities = ViewBag.OpeningQuantities as IReadOnlyDictionary<Guid, int> ?? new Dictionary<Guid, int>();
    var posDevices = ViewBag.PosDevices as IReadOnlyList<SistemiPos.Domain.Configuration.PosDevice> ?? [];
    var posPaymentsEnabled = ViewBag.PosPaymentsEnabled is true;
    var hasActivePosDevices = ViewBag.HasActivePosDevices is true;
}

<section class="page-header">
    <div>
        <p class="eyebrow">Caja</p>
        <h1>Abrir caja</h1>
        @if (Model.ReturnToSales)
        {
            <p class="lead">Para registrar una venta primero debes abrir tu caja. Al abrirla volverás automáticamente al punto de venta.</p>
        }
    </div>
</section>

<div class="form-card">
    <form method="post" class="cash-count-form" data-cash-count data-currency-symbol="@symbol" data-submission-lock>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <input asp-for="ReturnToSales" type="hidden" />
        <input asp-for="OpeningAmount" type="hidden" data-cash-count-value />
        <span asp-validation-for="OpeningAmount" class="validation"></span>

        @if (posPaymentsEnabled) {
        <section class="cash-pos-assignment" data-cash-pos-assignment>
            <div><h2>POS bancarios</h2><p class="helper-text">Active esta opción si cobrará con tarjeta durante esta caja.</p></div>
            <label class="checkbox cash-pos-opt-out"><input asp-for="UsePosDevices" type="checkbox" data-cash-pos-use/><span>Usaré POS en esta caja</span></label>
            <div class="cash-pos-options" data-cash-pos-options hidden>
                @foreach (var pos in posDevices)
                {
                    <label class="checkbox"><input type="checkbox" name="PosDeviceIds" value="@pos.Id" checked="@(Model.PosDeviceIds.Contains(pos.Id) ? "checked" : null)"/><span>@pos.Name@if (!string.IsNullOrWhiteSpace(pos.Provider)) { <small> · @pos.Provider</small> }</span></label>
                }
                @if (posDevices.Count > 0)
                {
                    <p class="helper-text">Seleccione el POS que utilizará. Solo se muestran dispositivos libres.</p>
                }
                else if (hasActivePosDevices)
                {
                    <p class="validation">No hay POS disponibles. Los dispositivos activos ya están asignados a otras cajas abiertas.</p>
                }
                else
                {
                    <p class="validation">No existen POS activos. Configúrelos en Administración &gt; Configuración &gt; Caja y pagos.</p>
                }
            </div>
            <span asp-validation-for="PosDeviceIds" class="validation"></span>
        </section>
        }

        <div class="cash-count-tables">
            <section class="cash-denomination-panel" aria-labelledby="opening-banknotes-title">
                <h3 id="opening-banknotes-title">Billetes</h3>
                <table class="cash-denomination-table">
                    <thead><tr><th>Denominación</th><th>Cantidad</th><th>Subtotal</th></tr></thead>
                    <tbody>
                    @foreach (var denomination in banknotes)
                    {
                        var quantity = enteredQuantities.GetValueOrDefault(denomination.Id);
                        <tr>
                            <td>@symbol @denomination.Value.ToString("N2")</td>
                            <td><input type="hidden" name="denominationIds" value="@denomination.Id"/><input name="quantities" type="number" min="0" step="1" value="@quantity" inputmode="numeric" pattern="[0-9]*" class="input cash-quantity-input" data-cash-quantity data-denomination-value="@denomination.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Cantidad de billetes de @symbol @denomination.Value.ToString("N2")"/></td>
                            <td><output data-cash-line-subtotal>@symbol 0.00</output></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </section>
            <section class="cash-denomination-panel" aria-labelledby="opening-coins-title">
                <h3 id="opening-coins-title">Monedas</h3>
                <table class="cash-denomination-table">
                    <thead><tr><th>Denominación</th><th>Cantidad</th><th>Subtotal</th></tr></thead>
                    <tbody>
                    @foreach (var denomination in coins)
                    {
                        var quantity = enteredQuantities.GetValueOrDefault(denomination.Id);
                        <tr>
                            <td>@symbol @denomination.Value.ToString("N2")</td>
                            <td><input type="hidden" name="denominationIds" value="@denomination.Id"/><input name="quantities" type="number" min="0" step="1" value="@quantity" inputmode="numeric" pattern="[0-9]*" class="input cash-quantity-input" data-cash-quantity data-denomination-value="@denomination.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Cantidad de monedas de @symbol @denomination.Value.ToString("N2")"/></td>
                            <td><output data-cash-line-subtotal>@symbol 0.00</output></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </section>
        </div>

        <div class="form-grid">
            <div class="field"><label asp-for="Observation"></label><textarea asp-for="Observation" class="input textarea"></textarea></div>
        </div>
        <div class="cash-count-footer">
            <div><span>Total inicial</span><strong data-cash-count-total>@symbol @Model.OpeningAmount.ToString("N2")</strong></div>
            <div class="action-row cash-opening-actions">
                <button type="submit" class="button-primary">Abrir caja</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
