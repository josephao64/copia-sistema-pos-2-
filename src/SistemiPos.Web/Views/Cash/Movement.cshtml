@model SistemiPos.Application.Cash.CashSessionDto
@using SistemiPos.Domain.Cash
@{
    ViewData["Title"] = "Registrar entrada o salida";
}

<section class="page-header cash-page-header">
    <div>
        <p class="eyebrow">Caja activa</p>
        <h1>Registrar entrada o salida</h1>
        <p class="lead">@Model.CashierUserName · abierta @Model.OpenedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
    </div>
</section>

@if (TempData["Error"] is string error) { <div class="alert-error">@error</div> }

<section class="form-card cash-movement-page-form">
    <form asp-action="AddMovement" method="post" class="form-grid cash-movement-modal-form" autocomplete="off">
        @Html.AntiForgeryToken()
        <input type="hidden" name="CashSessionId" value="@Model.Id" />
        <div class="field"><label>Entrada o salida</label><select name="Type" class="input"><option value="@CashMovementType.OtherIncome">Entrada</option><option value="@CashMovementType.Expense">Salida</option></select></div>
        <div class="field"><label>Monto</label><input name="Amount" type="text" inputmode="numeric" pattern="[1-9][0-9]*" class="input" data-positive-integer required /></div>
        <div class="field"><label>Motivo</label><input name="Reason" class="input" required /></div>
        <div class="field"><label>Usuario autorizador</label><input name="AuthorizerUserName" value="" class="input" autocomplete="off" data-lpignore="true" data-1p-ignore /></div>
        <div class="field"><label>Contraseña del autorizador</label><input name="AuthorizerPassword" value="" type="password" class="input" autocomplete="new-password" data-lpignore="true" data-1p-ignore /></div>
        <div class="action-row"><button class="button-primary">Registrar entrada o salida</button></div>
    </form>
</section>
