@model SistemiPos.Application.Inventory.InventoryMovementPage
@{
    ViewData["Title"] = "Kardex";
}

<section class="page-header">
    <div>
        <p class="eyebrow">Inventario</p>
        <h1>Kardex</h1>
    </div>
    <a asp-action="Export" asp-route-productId="@(ViewData["ProductId"])" class="button-secondary link-button">Exportar a Excel</a>
</section>

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Cantidad</th>
                <th>Anterior</th>
                <th>Nueva</th>
                <th>Usuario</th>
                <th>Documento</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.OccurredAtUtc.LocalDateTime.ToString("g")</td>
                <td>@item.ProductName</td>
                <td>@item.Type</td>
                <td>@DisplayFormats.Quantity(item.Quantity)</td>
                <td>@DisplayFormats.Quantity(item.PreviousStock)</td>
                <td>@DisplayFormats.Quantity(item.NewStock)</td>
                <td>@item.UserName</td>
                <td>@item.SourceDocument</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<nav class="action-row" aria-label="Paginación del Kardex">
    @if (Model.Page > 1)
    {
        <a asp-action="Kardex" asp-route-productId="@(ViewData["ProductId"])" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" class="button-secondary link-button">Anterior</a>
    }
    else
    {
        <button type="button" class="button-secondary" disabled>Anterior</button>
    }
    <span>Página @Model.Page de @Model.TotalPages · @Model.TotalCount registros</span>
    @if (Model.Page < Model.TotalPages)
    {
        <a asp-action="Kardex" asp-route-productId="@(ViewData["ProductId"])" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" class="button-secondary link-button">Siguiente</a>
    }
    else
    {
        <button type="button" class="button-secondary" disabled>Siguiente</button>
    }
</nav>
